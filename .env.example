# Domonap Telegram Bot .env configuration
#
# Required: Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# ALLOWED_TELEGRAM_USER_IDS — comma-separated Telegram user IDs (e.g. 111222333,444555666)
# Required: bot refuses to start if empty.
ALLOWED_TELEGRAM_USER_IDS=
# ADMIN_TELEGRAM_USER_IDS — comma-separated admin Telegram user IDs.
# Every admin must also be listed in ALLOWED_TELEGRAM_USER_IDS.
ADMIN_TELEGRAM_USER_IDS=
DOMONAP_PHONE=
# false (default): do not replace official app push routing; SignalR still receives calls.
# true: explicitly register this bot's deviceToken via UpdateDeviceToken.
DOMONAP_REGISTER_DEVICE_TOKEN=false
STORAGE_PATH=data/storage.db
# Required Fernet key for encrypting the persisted Domonap session.
# Generate once and keep it separately from database backups:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
LOG_LEVEL=INFO
CALL_WATCHER_ENABLED=true

# Automatic SQLite backup sidecar (Docker Compose).
# Default: every 6 hours, keep the newest 28 verified backups (~7 days).
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_COUNT=28
