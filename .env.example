# Domonap Telegram Bot .env configuration
#
# ALLOWED_TELEGRAM_USER_IDS — comma-separated Telegram user IDs (e.g. 111222333,444555666)
# Required: bot refuses to start if empty.
ALLOWED_TELEGRAM_USER_IDS=
# ADMIN_TELEGRAM_USER_IDS — comma-separated admin Telegram user IDs
# Must be listed in ALLOWED_TELEGRAM_USER_IDS to grant admin access.
ADMIN_TELEGRAM_USER_IDS=
DOMONAP_PHONE=
# false (default): do not replace official app push routing; SignalR still receives calls.
# true: explicitly register this bot's deviceToken via UpdateDeviceToken.
DOMONAP_REGISTER_DEVICE_TOKEN=false
STORAGE_PATH=data/storage.db
LOG_LEVEL=INFO
CALL_WATCHER_ENABLED=true
