# Domonap Telegram Bot .env configuration
#
# Required: Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# ALLOWED_TELEGRAM_USER_IDS — comma-separated Telegram user IDs (e.g. 111222333,444555666)
# Required: bot refuses to start if empty.
ALLOWED_TELEGRAM_USER_IDS=
# ADMIN_TELEGRAM_USER_IDS — comma-separated admin Telegram user IDs.
# Every admin must also be listed in ALLOWED_TELEGRAM_USER_IDS.
ADMIN_TELEGRAM_USER_IDS=
DOMONAP_PHONE=
# false (default): do not replace official app push routing; SignalR still receives calls.
# true: explicitly register this bot's deviceToken via UpdateDeviceToken.
DOMONAP_REGISTER_DEVICE_TOKEN=false
STORAGE_PATH=data/storage.db
# Required Fernet key for encrypting the persisted Domonap session.
# Generate once and keep it separately from database backups:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
LOG_LEVEL=INFO
CALL_WATCHER_ENABLED=true

# Optional WebRTC camera proxy. PUBLIC_BASE_URL must be reachable from the phone.
# Example: https://bot.example.com
PUBLIC_BASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CAMERA_PROXY_SECRET=
CAMERA_PROXY_PORT=8080
CAMERA_LINK_TTL_SECONDS=300

# Yandex Alice: Domonap -> Stations.
# Runs a pre-created Yandex Smart Home scenario when a LIVE SignalR call arrives.
# The token must have the iot:control permission. Automatic retries are intentionally disabled.
YANDEX_ANNOUNCEMENTS_ENABLED=false
YANDEX_IOT_OAUTH_TOKEN=
# JSON object: {"<domonap door_id>":"<yandex scenario_id>"}
YANDEX_SCENARIO_MAP={}

# Yandex Alice: Stations -> Domonap.
# Exposes one private Smart Home device named "Домофон" and opens only the current LIVE call.
YANDEX_SMART_HOME_ENABLED=false
# Keep true until end-to-end voice tests pass. Dry-run consumes the active call but does not touch relay.
YANDEX_SMART_HOME_DRY_RUN=true
# Separate aiohttp listener; publish through your existing HTTPS reverse proxy.
YANDEX_SMART_HOME_PORT=8081
# Hard safety window even if DomofonCallEnded is lost.
YANDEX_ACTIVE_CALL_TTL_SECONDS=60
# OAuth app used by private Smart Home account linking through Yandex ID.
YANDEX_ID_OAUTH_CLIENT_ID=
# Comma-separated or JSON array of allowed numeric Yandex user IDs.
YANDEX_ALLOWED_USER_IDS=[]

# Automatic SQLite backup sidecar (Docker Compose).
# Default: every 6 hours, keep the newest 28 verified backups (~7 days).
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETENTION_COUNT=28
